# Copy to frontend/.env.local (git-ignored). Read by Vite at dev and build time;
# everything here ends up in the browser, so never put secrets in it.

# Links each answer in the debug panel to its Langfuse trace (the trace id is the
# request id). Your project's URL, as shown in the browser when you open it:
# VITE_LANGFUSE_PROJECT_URL=https://us.cloud.langfuse.com/project/<project-id>

# Where the dev server sends /v1 and /health (default http://localhost:8000):
# VITE_API_TARGET=http://localhost:8000
