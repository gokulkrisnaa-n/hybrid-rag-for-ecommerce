POSTGRES_USER=user-name
POSTGRES_PASSWORD=your-password
POSTGRES_DB=db_name
DATABASE_URL=postgresql://user-name:your-password@localhost:5433/db_name

OPENAI_API_KEY=your-openai-api-key

