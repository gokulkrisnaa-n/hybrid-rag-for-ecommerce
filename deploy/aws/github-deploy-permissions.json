{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendOnlyTheDeployDocumentToOnlyThisServer",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ssm:us-east-2:ACCOUNT_ID:document/KithDeploy",
        "arn:aws:ec2:us-east-2:ACCOUNT_ID:instance/INSTANCE_ID"
      ]
    },
    {
      "Sid": "ReadTheDeployResult",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations"
      ],
      "Resource": "*"
    }
  ]
}